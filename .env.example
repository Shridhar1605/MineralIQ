# mineral-iq local dev (copy to .env — never commit .env)
DATABASE_URL=postgresql://mineraliq:mineraliq@localhost:5432/mineraliq
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/mineraliq
API_PORT=8000

# Google Cloud (patent harvesting). The key is a live credential: keep it
# OUTSIDE the repository. .gitignore matches the <project>-<keyid>.json shape
# service-account downloads use, but do not rely on that as the only defence.
#   mkdir -p ~/.config/mineraliq && chmod 700 ~/.config/mineraliq
#   mv ~/Downloads/<project>-<keyid>.json ~/.config/mineraliq/gcp-key.json
#   chmod 600 ~/.config/mineraliq/gcp-key.json
# The service account needs roles/bigquery.jobUser on the project to run any
# query, including a dry run.
GOOGLE_APPLICATION_CREDENTIALS=/Users/<you>/.config/mineraliq/gcp-key.json
GCP_PROJECT_ID=mineraliq-509317
